<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fasodev.gestionscolaire.ui.controllers.SetupController"
           styleClass="app-root">

    <stylesheets>
        <URL value="@../css/novera-theme.css"/>
    </stylesheets>

    <!-- Décor : halos de couleur flous derrière la carte -->
    <Pane fx:id="fond" mouseTransparent="true"/>

    <HBox fx:id="carte" styleClass="lg-card" alignment="CENTER"
          maxWidth="900" maxHeight="580" minHeight="500">
        <StackPane.margin><Insets top="24" right="28" bottom="24" left="28"/></StackPane.margin>

        <!-- Panneau de gauche : bienvenue et étapes -->
        <StackPane styleClass="lg-hero" HBox.hgrow="ALWAYS" prefWidth="360" minWidth="280">
            <VBox spacing="16" alignment="TOP_LEFT">
                <padding><Insets top="36" right="32" bottom="30" left="36"/></padding>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane styleClass="lg-badge"><Label text="N"/></StackPane>
                    <Label text="Novera" styleClass="lg-brand"/>
                </HBox>

                <Label text="Bienvenue ! Configurons votre école." styleClass="lg-hero-title" wrapText="true"/>
                <Label text="Deux minutes suffisent pour démarrer." styleClass="lg-hero-sub"/>

                <VBox spacing="12">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane styleClass="lg-step"><Label text="1"/></StackPane>
                        <Label text="Votre établissement" styleClass="lg-feature"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane styleClass="lg-step"><Label text="2"/></StackPane>
                        <Label text="Votre compte Directeur" styleClass="lg-feature"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane styleClass="lg-step"><Label text="3"/></StackPane>
                        <Label text="Vous êtes prêt à commencer" styleClass="lg-feature"/>
                    </HBox>
                </VBox>
            </VBox>

            <StackPane fx:id="illustrationHolder" StackPane.alignment="BOTTOM_RIGHT"
                       maxWidth="-Infinity" maxHeight="-Infinity" mouseTransparent="true">
                <StackPane.margin><Insets right="20" bottom="16"/></StackPane.margin>
            </StackPane>
        </StackPane>

        <!-- Panneau de droite : formulaire -->
        <VBox styleClass="lg-form, lg-form-compact" HBox.hgrow="ALWAYS" prefWidth="480" minWidth="360"
              alignment="CENTER_LEFT" spacing="7">

            <Label text="Première configuration" styleClass="lg-title"/>
            <Label text="Ces informations pourront être modifiées plus tard." styleClass="lg-subtitle" wrapText="true"/>

            <VBox spacing="5">
                <Label text="Nom de l'établissement" styleClass="lg-label"/>
                <HBox fx:id="coqueEcole" styleClass="lg-shell" alignment="CENTER_LEFT" spacing="8">
                    <StackPane fx:id="iconeEcole"/>
                    <TextField fx:id="nomEcoleField" promptText="ex : Lycée Saint Joseph Kadiogo" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <VBox spacing="5">
                <Label text="Nom d'utilisateur (Directeur)" styleClass="lg-label"/>
                <HBox fx:id="coqueUtilisateur" styleClass="lg-shell" alignment="CENTER_LEFT" spacing="8">
                    <StackPane fx:id="iconeUtilisateur"/>
                    <TextField fx:id="nomUtilisateurField" promptText="ex : directeur" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <VBox spacing="5">
                <Label text="Mot de passe" styleClass="lg-label"/>
                <HBox fx:id="coqueMotDePasse" styleClass="lg-shell" alignment="CENTER_LEFT" spacing="8">
                    <StackPane fx:id="iconeCadenas"/>
                    <StackPane HBox.hgrow="ALWAYS">
                        <PasswordField fx:id="motDePasseField" promptText="Au moins 6 caractères"/>
                        <TextField fx:id="motDePasseVisibleField" promptText="Au moins 6 caractères"
                                   visible="false" managed="false"/>
                    </StackPane>
                    <Button fx:id="oeilButton" styleClass="lg-eye" onAction="#onOeilClick"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <HBox fx:id="forceBarre" spacing="4" HBox.hgrow="ALWAYS" prefHeight="6" maxHeight="6"/>
                    <Label fx:id="forceLabel" styleClass="lg-hint" minWidth="40"/>
                </HBox>
            </VBox>

            <VBox spacing="5">
                <Label text="Confirmer le mot de passe" styleClass="lg-label"/>
                <HBox fx:id="coqueConfirmation" styleClass="lg-shell" alignment="CENTER_LEFT" spacing="8">
                    <StackPane fx:id="iconeConfirmation"/>
                    <PasswordField fx:id="confirmerMotDePasseField" promptText="Retapez le mot de passe"
                                   HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="confirmationLabel" styleClass="lg-hint" managed="false" visible="false"/>
            </VBox>

            <Label fx:id="erreurLabel" styleClass="lg-error" wrapText="true" maxWidth="Infinity" visible="false"/>

            <Button fx:id="terminerButton" text="Terminer la configuration" styleClass="lg-button"
                    maxWidth="Infinity" onAction="#onTerminerClick" defaultButton="true"/>
        </VBox>
    </HBox>
</StackPane>