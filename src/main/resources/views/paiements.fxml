<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fasodev.gestionscolaire.ui.controllers.PaiementsController"
      spacing="0" styleClass="content-area">

    <VBox HBox.hgrow="ALWAYS" spacing="12" styleClass="content-area">
        <padding><Insets top="20" right="15" bottom="20" left="20"/></padding>

        <Label text="💰 Paiements" styleClass="section-title"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Classe :" styleClass="field-label"/>
            <ComboBox fx:id="classeCombo"/>
            <Label text="Étudiant :" styleClass="field-label"/>
            <ComboBox fx:id="etudiantCombo" prefWidth="220"/>
        </HBox>

        <VBox fx:id="soldeBox" spacing="8" styleClass="matiere-card" managed="false" visible="false">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
            <Label fx:id="fraisNormalLabel" styleClass="field-label"/>
            <Label fx:id="subventionLabel" styleClass="moyenne-preview"/>
            <Label fx:id="fraisReelLabel" styleClass="matiere-title"/>
            <Label fx:id="totalPayeLabel" styleClass="field-label"/>
            <Label fx:id="soldeLabel" styleClass="matiere-title"/>
        </VBox>

        <Label text="Historique des paiements" styleClass="field-label"/>
        <TableView fx:id="historiqueTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                <TableColumn fx:id="colMontant" text="Montant" prefWidth="120"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
                <TableColumn fx:id="colNotes" text="Notes" prefWidth="200"/>
            </columns>
        </TableView>

        <Label fx:id="messageLabel" styleClass="info-label" wrapText="true"/>
    </VBox>

    <VBox prefWidth="300" spacing="12" styleClass="form-panel">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <Label text="Nouveau paiement" styleClass="section-title"/>

        <VBox spacing="6">
            <Label text="Montant (FCFA)" styleClass="field-label"/>
            <TextField fx:id="montantField" promptText="ex: 25000"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Date" styleClass="field-label"/>
            <DatePicker fx:id="dateField" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Notes (optionnel)" styleClass="field-label"/>
            <TextField fx:id="notesField"/>
        </VBox>

        <Label fx:id="erreurLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>

        <Button text="💾 Enregistrer le paiement" styleClass="primary-button-small"
                onAction="#onEnregistrerClick" maxWidth="Infinity"/>

        <Button fx:id="imprimerRecuButton" text="🖨️ Imprimer le reçu"
                styleClass="secondary-button" maxWidth="Infinity"
                onAction="#onImprimerRecuClick" disable="true"/>

    </VBox>

</HBox>
