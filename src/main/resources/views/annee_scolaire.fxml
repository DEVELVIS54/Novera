<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fasodev.gestionscolaire.ui.controllers.AnneeScolaireController"
      spacing="15" styleClass="content-area">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="📅 Année scolaire" styleClass="section-title"/>

    <Label wrapText="true" styleClass="info-label"
           text="Les notes, les calculs de moyennes et les bulletins concernent l'année active. Les données des autres années sont conservées : changez d'année pour les consulter."/>

    <VBox spacing="8" styleClass="form-panel" maxWidth="520">
        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
        <Label text="Année active" styleClass="field-label"/>
        <Label fx:id="anneeActiveLabel" styleClass="section-title"/>
        <Label text="Changer d'année" styleClass="field-label"/>
        <ComboBox fx:id="anneeCombo" maxWidth="Infinity"/>
        <HBox spacing="10">
            <Button text="✅ Activer cette année" styleClass="primary-button-small" onAction="#onActiverClick"/>
            <Button text="➕ Ouvrir l'année suivante" styleClass="secondary-button" onAction="#onOuvrirSuivanteClick"/>
        </HBox>
    </VBox>

    <Label fx:id="messageLabel" wrapText="true" styleClass="info-label"/>
</VBox>