<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fasodev.gestionscolaire.ui.controllers.SynchronisationController"
      spacing="15" styleClass="content-area">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="☁️ Synchronisation avec le serveur" styleClass="section-title"/>

    <Label wrapText="true" styleClass="info-label"
           text="L'application fonctionne toujours en local. Les modifications sont envoyées au serveur dès qu'il est joignable."/>

    <VBox spacing="8" styleClass="form-panel" maxWidth="520">
        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
        <Label text="Adresse du serveur" styleClass="field-label"/>
        <TextField fx:id="urlField" promptText="https://novera.exemple.com"/>
        <Label text="Clé d'accès" styleClass="field-label"/>
        <PasswordField fx:id="cleField"/>
        <HBox spacing="10">
            <Button text="💾 Enregistrer" styleClass="primary-button-small" onAction="#onEnregistrerClick"/>
            <Button fx:id="testerButton" text="🔌 Tester la connexion" styleClass="secondary-button"
                    onAction="#onTesterClick"/>
        </HBox>
    </VBox>

    <HBox spacing="12">
        <Button fx:id="synchroButton" text="🔄 Synchroniser maintenant" styleClass="primary-button-small"
                onAction="#onSynchroniserClick"/>
    </HBox>

    <Label fx:id="enAttenteLabel" styleClass="info-label"/>
    <Label fx:id="messageLabel" wrapText="true" styleClass="info-label"/>
</VBox>
