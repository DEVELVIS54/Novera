<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fasodev.gestionscolaire.ui.controllers.PassageClasseController"
      spacing="15"
      styleClass="content-area">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- Titre -->
    <Label text="📊 Passage en Classe Supérieure" styleClass="section-title"/>

    <!-- Panneau de configuration -->
    <VBox spacing="10" style="-fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 15;">

        <!-- Sélection classe & année -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label text="Classe :" styleClass="label-bold" prefWidth="60"/>
            <ComboBox fx:id="comboClasse" prefWidth="150"/>
            
            <Label text="Année scolaire :" styleClass="label-bold" prefWidth="120"/>
            <ComboBox fx:id="comboAnneeScolaire" prefWidth="150"/>
        </HBox>

        <!-- Affichage des seuils actuels -->
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #f5f5f5; -fx-padding: 10; -fx-border-radius: 3;">
            <Label fx:id="lblSeuilAdmission" text="Seuil admission : 10.00/20" 
                   style="-fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="lblSeuilRedoublement" text="Seuil redoublement : 8.00/20" 
                   style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnConfigSeuils" text="⚙ Configurer" styleClass="btn-secondary" prefWidth="120"/>
        </HBox>

        <!-- Boutons d'action -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="btnCalculer" text="📋 Calculer Passages" styleClass="btn-primary" prefWidth="180"/>
            <Button fx:id="btnValiderDeliberations" text="✓ Valider Délibérations" styleClass="btn-warning" prefWidth="180"/>
            <Button fx:id="btnAppliquerPassages" text="✓ Appliquer Passages" styleClass="btn-success" prefWidth="180"/>
        </HBox>

        <!-- Statut -->
        <Label fx:id="lblStatut" text="En attente..." styleClass="status-label"/>

    </VBox>

    <!-- Statistiques -->
    <Label fx:id="lblStatistiques" text="📊 Résultats : 0 ADMIS | 0 REDOUBLE | 0 DÉLIBÉRATION" 
           style="-fx-font-size: 12; -fx-text-fill: #333; -fx-font-weight: bold;"/>

    <!-- Tableau des résultats -->
    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <Label text="Résultats Détaillés :" styleClass="label-bold"/>

        <TableView fx:id="tableResultats" prefHeight="400" VBox.vgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="colEtudiant" text="Étudiant" prefWidth="180"/>
                <TableColumn fx:id="colClasse" text="Classe Actuelle" prefWidth="100"/>
                <TableColumn fx:id="colMoyenneAnnuelle" text="Moyenne Annuelle" prefWidth="130" 
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colStatutCalcule" text="Statut Calculé" prefWidth="120" 
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colStatutFinal" text="Statut Final" prefWidth="100" 
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="100" 
                             style="-fx-alignment: CENTER;"/>
            </columns>

            <columnResizePolicy>
                <TableView.CONSTRAINED_RESIZE_POLICY/>
            </columnResizePolicy>

        </TableView>

        <!-- Légende -->
        <VBox spacing="5" style="-fx-background-color: #f9f9f9; -fx-padding: 10; -fx-border-radius: 3;">
            <Label text="Légende :" styleClass="label-bold" style="-fx-font-size: 11;"/>
            <Label text="🟢 ADMIS : Moyenne >= seuil admission → Passe automatiquement à la classe supérieure" 
                   wrapText="true" style="-fx-font-size: 10;"/>
            <Label text="🔴 REDOUBLE : Moyenne < seuil redoublement → Redouble sa classe actuelle" 
                   wrapText="true" style="-fx-font-size: 10;"/>
            <Label text="🟡 DÉLIBÉRATION : Moyenne entre les deux seuils → Conseil de classe, décision manuelle" 
                   wrapText="true" style="-fx-font-size: 10;"/>
            <Label text="💡 Conseil : D'abord calculer les passages, puis valider les délibérations, enfin appliquer." 
                   wrapText="true" style="-fx-font-size: 10; -fx-font-style: italic; -fx-text-fill: #666;"/>
        </VBox>

    </VBox>

</VBox>
