<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fasodev.gestionscolaire.ui.controllers.RechercheController"
      spacing="15" styleClass="content-area">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="🔍 Recherche" styleClass="section-title"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="rechercheField" promptText="Nom, prénom, matricule, classe…" prefWidth="360"/>
        <Button text="Rechercher" styleClass="primary-button-small" onAction="#onRechercherClick"/>
        <Label fx:id="resumeLabel" styleClass="info-label"/>
    </HBox>

    <Label text="Élèves" styleClass="field-label"/>
    <TableView fx:id="elevesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colMatricule" text="Matricule" prefWidth="120"/>
            <TableColumn fx:id="colEleve" text="Élève" prefWidth="240"/>
            <TableColumn fx:id="colClasseEleve" text="Classe" prefWidth="140"/>
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="200"/>
        </columns>
    </TableView>

    <Label text="Classes" styleClass="field-label"/>
    <TableView fx:id="classesTable" prefHeight="160">
        <columns>
            <TableColumn fx:id="colClasse" text="Classe" prefWidth="200"/>
            <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="140"/>
            <TableColumn fx:id="colEffectif" text="Effectif actif" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
