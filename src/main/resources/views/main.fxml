<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="appRoot" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fasodev.gestionscolaire.ui.controllers.MainController"
           styleClass="app-root">

    <stylesheets>
        <URL value="@../css/novera-theme.css"/>
    </stylesheets>

    <!-- Décor : halos de couleur flous derrière l'interface -->
    <Pane fx:id="fond" mouseTransparent="true"/>

    <BorderPane fx:id="rootPane">

        <top>
            <HBox styleClass="topbar" spacing="16" alignment="CENTER_LEFT">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane styleClass="brand-badge"><Label text="N"/></StackPane>
                    <VBox>
                        <Label text="Novera" styleClass="brand-name"/>
                        <Label fx:id="schoolLabel" styleClass="brand-sub"/>
                    </VBox>
                </HBox>

                <HBox HBox.hgrow="ALWAYS"/>

                <HBox fx:id="searchPill" styleClass="search-pill" spacing="10" alignment="CENTER_LEFT"
                      onMouseClicked="#onPaletteClick">
                    <StackPane fx:id="searchIconHolder"/>
                    <Label text="Rechercher ou aller à…" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="Ctrl K" styleClass="keycap"/>
                </HBox>

                <HBox HBox.hgrow="ALWAYS"/>

                <HBox styleClass="sync-chip" spacing="8" alignment="CENTER_LEFT">
                    <Circle fx:id="syncStatusCircle" radius="5"/>
                    <Label fx:id="syncStatusLabel" text="Hors ligne"/>
                    <Label fx:id="pendingSyncLabel"/>
                </HBox>

                <HBox fx:id="userChip" styleClass="user-chip" spacing="10" alignment="CENTER_LEFT"
                      onMouseClicked="#onUserClick">
                    <StackPane styleClass="avatar"><Label fx:id="avatarLabel"/></StackPane>
                    <VBox>
                        <Label fx:id="userLabel" styleClass="user-name"/>
                        <Label fx:id="roleLabel" styleClass="user-role"/>
                    </VBox>
                </HBox>
            </HBox>
        </top>

        <bottom>
            <VBox fx:id="dockHolder" alignment="CENTER">
                <padding><Insets top="4" right="0" bottom="14" left="0"/></padding>
            </VBox>
        </bottom>

    </BorderPane>

    <!-- Couche des fenêtres volantes et de la palette de commandes -->
    <StackPane fx:id="couche"/>
</StackPane>
