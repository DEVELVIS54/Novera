<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fasodev.gestionscolaire.ui.controllers.ReinscriptionsController"
      spacing="15"
      styleClass="content-area">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- Titre -->
    <Label text="🔄 Gestion des Réinscriptions" styleClass="section-title"/>

    <!-- Statistiques -->
    <Label fx:id="lblStatistiques" text="📊 Réinscriptions : 0 confirmées, 0 en attente" 
           style="-fx-font-size: 12; -fx-text-fill: #333; -fx-font-weight: bold;"/>

    <!-- Onglets -->
    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">

        <!-- Onglet : En Attente -->
        <Tab fx:id="tabEnAttente" text="⏳ En Attente">
            <VBox spacing="10" style="-fx-padding: 15;">

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Année scolaire :" styleClass="label-bold"/>
                    <ComboBox fx:id="comboAnneeEnAttente" prefWidth="150"/>
                </HBox>

                <TableView fx:id="tableEnAttente" prefHeight="400" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colEtudiantAttente" text="Étudiant" prefWidth="150"/>
                        <TableColumn fx:id="colClasseAttente" text="Nouvelle Classe" prefWidth="150"/>
                        <TableColumn fx:id="colStatutAttente" text="Statut" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colActionsAttente" text="Actions" prefWidth="200" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView.CONSTRAINED_RESIZE_POLICY/>
                    </columnResizePolicy>
                </TableView>

                <Label text="💡 Cliquer [✓ Confirmer] pour valider la réinscription du parent" 
                       wrapText="true" style="-fx-font-size: 10; -fx-text-fill: #666;"/>

            </VBox>
        </Tab>

        <!-- Onglet : Confirmées -->
        <Tab fx:id="tabConfirmees" text="✓ Confirmées">
            <VBox spacing="10" style="-fx-padding: 15;">

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Année scolaire :" styleClass="label-bold"/>
                    <ComboBox fx:id="comboAnneeConfirmees" prefWidth="150"/>
                </HBox>

                <TableView fx:id="tableConfirmees" prefHeight="400" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colEtudiantConfirmee" text="Étudiant" prefWidth="150"/>
                        <TableColumn fx:id="colClasseConfirmee" text="Nouvelle Classe" prefWidth="150"/>
                        <TableColumn fx:id="colConfirmeeParColumn" text="Confirmé par" prefWidth="200"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView.CONSTRAINED_RESIZE_POLICY/>
                    </columnResizePolicy>
                </TableView>

                <Label text="✅ Ces étudiants sont confirmés pour la réinscription" 
                       wrapText="true" style="-fx-font-size: 10; -fx-text-fill: #27ae60;"/>

            </VBox>
        </Tab>

        <!-- Onglet : Refusées -->
        <Tab text="✗ Refusées">
            <VBox spacing="10" style="-fx-padding: 15; -fx-alignment: CENTER;">
                <Label text="Les réinscriptions refusées sont marquées comme \"Parti\" en base"
                       wrapText="true" style="-fx-font-size: 11;"/>
            </VBox>
        </Tab>

    </TabPane>

    <!-- Bloc d'info -->
    <VBox spacing="5" style="-fx-background-color: #f0f8ff; -fx-padding: 10; -fx-border-radius: 3;">
        <Label text="ℹ️ Flux Réinscription :" styleClass="label-bold" style="-fx-font-size: 11;"/>
        <Label text="• Élève admis examen → Demande réinscription créée (En attente)" 
               wrapText="true" style="-fx-font-size: 10;"/>
        <Label text="• Parent confirme (email reçu via futur portail) → Statut Confirmée" 
               wrapText="true" style="-fx-font-size: 10;"/>
        <Label text="• Délai expiré ou refus → Élève considéré Parti" 
               wrapText="true" style="-fx-font-size: 10;"/>
        <Label text="• Cas spécial : Classe Terminale (fin de parcours) → Sortie automatique, pas de réinscription" 
               wrapText="true" style="-fx-font-size: 10; -fx-text-fill: #e74c3c;"/>
    </VBox>

</VBox>
