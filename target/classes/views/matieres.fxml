<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fasodev.gestionscolaire.ui.controllers.MatieresController"
      spacing="0" styleClass="content-area">

    <VBox HBox.hgrow="ALWAYS" spacing="12" styleClass="content-area">
        <padding><Insets top="20" right="15" bottom="20" left="20"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="📚 Matières" styleClass="section-title"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="filtreClasseCombo" promptText="Toutes les classes"/>
            <Button text="➕ Nouvelle matière" styleClass="primary-button-small"
                    onAction="#onNouvelleMatiereClick"/>
        </HBox>

        <TableView fx:id="matieresTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNom" text="Matière" prefWidth="130"/>
                <TableColumn fx:id="colProfesseur" text="Professeur" prefWidth="130"/>
                <TableColumn fx:id="colClasse" text="Classe" prefWidth="90"/>
                <TableColumn fx:id="colCoefficient" text="Coeff." prefWidth="70"/>
                <TableColumn fx:id="colBareme" text="Barème" prefWidth="90"/>
            </columns>
        </TableView>

        <Label fx:id="messageLabel" styleClass="info-label" wrapText="true"/>
    </VBox>

    <VBox prefWidth="300" spacing="12" styleClass="form-panel">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <Label fx:id="formTitleLabel" text="Nouvelle matière" styleClass="section-title"/>

        <VBox spacing="6">
            <Label text="Nom de la matière" styleClass="field-label"/>
            <TextField fx:id="nomField" promptText="ex: Mathématiques"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Nom du professeur" styleClass="field-label"/>
            <TextField fx:id="professeurField" promptText="ex: M. Ouédraogo"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Classe" styleClass="field-label"/>
            <ComboBox fx:id="classeCombo" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Coefficient" styleClass="field-label"/>
            <TextField fx:id="coefficientField" promptText="ex: 3"/>
        </VBox>

        <HBox spacing="10">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Barème min" styleClass="field-label"/>
                <TextField fx:id="baremeMinField" promptText="0"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Barème max" styleClass="field-label"/>
                <TextField fx:id="baremeMaxField" promptText="20"/>
            </VBox>
        </HBox>

        <Label fx:id="erreurLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>

        <HBox spacing="8">
            <Button text="Enregistrer" styleClass="primary-button-small"
                    onAction="#onEnregistrerClick" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Annuler" styleClass="secondary-button"
                    onAction="#onAnnulerClick"/>
        </HBox>

        <Button fx:id="supprimerButton" text="🗑️ Supprimer cette matière"
                styleClass="danger-button" maxWidth="Infinity"
                onAction="#onSupprimerClick" managed="false" visible="false"/>

    </VBox>

</HBox>
