<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fasodev.gestionscolaire.ui.controllers.MoyennesController"
      spacing="15" styleClass="content-area">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="📊 Calcul des moyennes" styleClass="section-title"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Classe :" styleClass="field-label"/>
        <ComboBox fx:id="classeCombo"/>
        <Label text="Trimestre :" styleClass="field-label"/>
        <ComboBox fx:id="trimestreCombo"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Label fx:id="statutLabel" styleClass="info-label"/>
    </HBox>

    <HBox spacing="10">
        <Button fx:id="calculerButton" text="📊 Calculer les moyennes de cette classe"
                styleClass="primary-button-small" onAction="#onCalculerClick"/>
        <Button fx:id="deverrouillerButton" text="🔓 Déverrouiller"
                styleClass="danger-button" onAction="#onDeverrouillerClick"
                visible="false" managed="false"/>
    </HBox>

    <VBox fx:id="deverrouillageBox" spacing="8" managed="false" visible="false">
        <Label text="Raison du déverrouillage (obligatoire)" styleClass="field-label"/>
        <TextArea fx:id="raisonField" prefRowCount="2"/>
        <Button text="Confirmer le déverrouillage" styleClass="danger-button"
                onAction="#onConfirmerDeverrouillageClick"/>
    </VBox>

    <Label fx:id="messageLabel" styleClass="info-label" wrapText="true"/>
    <Label fx:id="erreurLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>

    <TableView fx:id="resultatsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRang" text="Rang" prefWidth="60"/>
            <TableColumn fx:id="colNom" text="Étudiant" prefWidth="250"/>
            <TableColumn fx:id="colMoyenne" text="Moyenne" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>
