<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fasodev.gestionscolaire.ui.controllers.FraisScolariteController"
      spacing="0" styleClass="content-area">

    <VBox HBox.hgrow="ALWAYS" spacing="12" styleClass="content-area">
        <padding><Insets top="20" right="15" bottom="20" left="20"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="🎓 Frais de scolarité" styleClass="section-title"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="➕ Nouveau frais" styleClass="primary-button-small"
                    onAction="#onNouveauClick"/>
        </HBox>

        <Label text="Une classe peut avoir plusieurs lignes de frais (ex: scolarité + cotisation) — le total est additionné."
               styleClass="info-label" wrapText="true"/>

        <TableView fx:id="fraisTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colClasse" text="Classe" prefWidth="140"/>
                <TableColumn fx:id="colDescription" text="Description" prefWidth="180"/>
                <TableColumn fx:id="colMontant" text="Montant (FCFA)" prefWidth="130"/>
            </columns>
        </TableView>

        <Label fx:id="messageLabel" styleClass="info-label" wrapText="true"/>
    </VBox>

    <VBox prefWidth="300" spacing="12" styleClass="form-panel">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <Label fx:id="formTitleLabel" text="Nouveau frais" styleClass="section-title"/>

        <VBox spacing="6">
            <Label text="Classe" styleClass="field-label"/>
            <ComboBox fx:id="classeCombo" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Description" styleClass="field-label"/>
            <TextField fx:id="descriptionField" promptText="ex: Scolarité annuelle"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Montant (FCFA)" styleClass="field-label"/>
            <TextField fx:id="montantField" promptText="ex: 150000"/>
        </VBox>

        <Label fx:id="erreurLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>

        <HBox spacing="8">
            <Button text="Enregistrer" styleClass="primary-button-small"
                    onAction="#onEnregistrerClick" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Annuler" styleClass="secondary-button"
                    onAction="#onAnnulerClick"/>
        </HBox>

        <Button fx:id="supprimerButton" text="🗑️ Supprimer"
                styleClass="danger-button" maxWidth="Infinity"
                onAction="#onSupprimerClick" managed="false" visible="false"/>

    </VBox>

</HBox>
