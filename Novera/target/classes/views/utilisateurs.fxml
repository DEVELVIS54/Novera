<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fasodev.gestionscolaire.ui.controllers.UtilisateursController"
      spacing="15" styleClass="content-area">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="👥 Utilisateurs" styleClass="section-title"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="nomField" promptText="Nom d'utilisateur"/>
        <PasswordField fx:id="motDePasseField" promptText="Mot de passe"/>
        <Button text="➕ Créer un compte Secrétaire" styleClass="primary-button-small" onAction="#onCreerClick"/>
    </HBox>

    <HBox spacing="10">
        <Button text="Activer / désactiver" styleClass="secondary-button" onAction="#onBasculerEtatClick"/>
        <Button text="🔑 Réinitialiser le mot de passe" styleClass="secondary-button" onAction="#onReinitialiserClick"/>
    </HBox>

    <Label fx:id="messageLabel" wrapText="true" styleClass="info-label"/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNom" text="Nom d'utilisateur" prefWidth="250"/>
            <TableColumn fx:id="colRole" text="Rôle" prefWidth="140"/>
            <TableColumn fx:id="colEtat" text="État" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>
