<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fasodev.gestionscolaire.ui.controllers.ClassesController"
      spacing="0" styleClass="content-area">

    <!-- ===== Colonne gauche : liste des classes ===== -->
    <VBox HBox.hgrow="ALWAYS" spacing="12" styleClass="content-area">
        <padding><Insets top="20" right="15" bottom="20" left="20"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="🏫 Classes" styleClass="section-title"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="➕ Nouvelle classe" styleClass="primary-button-small"
                    onAction="#onNouvelleClasseClick"/>
        </HBox>

        <TableView fx:id="classesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNom" text="Nom" prefWidth="150"/>
                <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="120"/>
                <TableColumn fx:id="colExamen" text="Classe d'examen" prefWidth="150"/>
                <TableColumn fx:id="colFinParcours" text="Fin de parcours" prefWidth="130"/>
            </columns>
        </TableView>

        <Label fx:id="messageLabel" styleClass="info-label" wrapText="true"/>
    </VBox>

    <!-- ===== Colonne droite : formulaire ajout/modification ===== -->
    <VBox prefWidth="320" spacing="12" styleClass="form-panel">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <Label fx:id="formTitleLabel" text="Nouvelle classe" styleClass="section-title"/>

        <VBox spacing="6">
            <Label text="Nom de la classe" styleClass="field-label"/>
            <TextField fx:id="nomField" promptText="ex: 6ème A"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Niveau" styleClass="field-label"/>
            <TextField fx:id="niveauField" promptText="ex: 6ème"/>
        </VBox>

        <CheckBox fx:id="examenCheckBox" text="Classe d'examen national"
                   onAction="#onExamenCheckBoxChange"/>

        <VBox fx:id="examenDetailsBox" spacing="6" managed="false" visible="false">
            <Label text="Nom de l'examen" styleClass="field-label"/>
            <TextField fx:id="nomExamenField" promptText="ex: BEPC"/>
            <CheckBox fx:id="finParcoursCheckBox" text="Classe de fin de parcours (ex: Terminale)"/>
        </VBox>

        <Label fx:id="erreurLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>

        <HBox spacing="8">
            <Button text="Enregistrer" styleClass="primary-button-small"
                    onAction="#onEnregistrerClick" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Annuler" styleClass="secondary-button"
                    onAction="#onAnnulerClick"/>
        </HBox>

        <Button fx:id="supprimerButton" text="🗑️ Supprimer cette classe"
                styleClass="danger-button" maxWidth="Infinity"
                onAction="#onSupprimerClick" managed="false" visible="false"/>

    </VBox>

</HBox>
